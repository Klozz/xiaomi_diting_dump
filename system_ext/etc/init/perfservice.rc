service vendor.perfservice /system_ext/bin/perfservice
    class main
    user system
    group system readproc

# MIUI ADD: CUTTLEFISH_MiuiCuttlefishFrame
on property:ro.soc.manufacturer=Google
    stop vendor.perfservice
# END CUTTLEFISH_MiuiCuttlefishFrame